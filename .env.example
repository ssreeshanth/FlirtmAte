PORT=3001
DB_PATH=./data/flirtmate.db
AI_PROVIDER=openai
OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=replace-with-openai-model
GEMINI_API_KEY=replace-with-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TEMPERATURE=1
AI_TIMEOUT_MS=25000
AI_TOTAL_TIMEOUT_MS=60000
RATE_LIMIT_PER_MIN=20
AI_DAILY_REQUEST_LIMIT=100
TRUST_PROXY=0
SESSION_SECRET=generate-a-random-secret-of-at-least-32-bytes
PRIVACY_CONTACT_EMAIL=privacy@example.com
NODE_ENV=development
