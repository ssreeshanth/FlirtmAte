{
  "name": "flirtmate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "start:all": "npm run dev",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "test": "vitest run tests/unit tests/integration tests/dom",
    "test:e2e": "playwright test",
    "test:live": "vitest run tests/live",
    "check": "node scripts/check-hardcoded.js && npm run build && node scripts/check-bundle.js"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "openai": "^6.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.4",
    "cross-env": "^10.1.0",
    "jsdom": "^27.0.0",
    "supertest": "^7.1.4",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
